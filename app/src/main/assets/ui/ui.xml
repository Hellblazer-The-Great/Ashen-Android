<?xml version="1.0" encoding="UTF-8"?>
<!--
  UI layout for Ashen Prototype. Coordinates are in logical screen units (960x540).
  x / y are absolute. cx is an offset from the horizontal centre, cy from the vertical centre.
  dx / dy are offsets from the thing being drawn (an enemy, a bonfire, the stain...).
-->
<ui>
  <!-- ===== HUD ===== -->
  <bar id="health" x="20" y="20" scale="2.2" height="14" color="#be2323"/>
  <bar id="stamina" x="20" y="40" scale="2.2" height="9" color="#46aa46"/>
  <text id="weapon" x="20" y="70" size="14" color="#ffffff"/>
  <text id="souls" x="20" y="92" size="18" color="#a0e6ff"/>
  <bar id="bossBar" cx="-250" y="20" width="500" height="12" color="#a01e1e"/>
  <text id="bossName" cx="0" y="50" size="16" color="#ffffff"/>
  <text id="banner" cy="-40" size="30" deadSize="56" color="#ffffff"/>
  <fade id="deathFade" maxAlpha="170" rate="90"/>
  <text id="deathText" cy="0" size="64" color="#be1919" text="YOU DIED"/>

  <!-- ===== Version (keep text equal to appVersionName in gradle.properties) ===== -->
  <text id="version" x="868" y="530" size="12" color="#7a7a7a" text="v0.3.0"/>

  <!-- ===== World labels ===== -->
  <text id="restPrompt" dy="-90" size="16" color="#ffffff" text="REST"/>
  <text id="stainValue" dy="-28" size="12" color="#a0e6ff"/>
  <fill id="stain" color="#78dcff" alpha="200" dy="-20" width="20" height="20"/>
  <bar id="enemyBar" dx="-20" dy="-10" width="40" height="4" color="#be2828"/>
  <text id="alert" dy="-14" size="22" color="#ffdc3c" text="!"/>

  <!-- ===== Bonfire level-up menu ===== -->
  <panel id="menuPanel" cx="-220" y="90" width="440" height="300" alpha="200" color="#000000"/>
  <text id="menuTitle" cx="0" y="130" size="24" color="#ffb440" text="BONFIRE - Level Up"/>
  <text id="menuInfo" cx="0" y="160" size="14" color="#ffffff"/>
  <list id="menuRows" cx="-120" y="200" step="36" size="20" color="#d3d3d3" selected="#ffff00"/>
  <text id="menuLeave" text="Leave"/>
  <text id="menuHint" cx="0" y="375" size="12" color="#888888" text="UP / DOWN choose    OK confirm    BACK close"/>

  <!-- ===== Analog movement stick (floating). Pressing inside the zone places the stick under the finger.
       radius: how far the knob travels. deadzone: fraction of radius ignored. x/y: idle position of the hint ring. ===== -->
  <joystick id="move" x="150" y="455" radius="80" deadzone="0.12" zoneX="0" zoneY="250" zoneW="500" zoneH="290" color="#ffffff"/>

  <!-- ===== Touch buttons. action = input action, label = text shown on the button ===== -->
  <touch>
    <!-- gameplay -->
    <button group="game" action="jump" label="JUMP" x="150" y="365" r="44"/>
    <button group="game" action="light" label="LIGHT" x="840" y="455" r="56"/>
    <button group="game" action="heavy" label="HEAVY" x="730" y="455" r="50"/>
    <button group="game" action="block" label="BLOCK" x="840" y="345" r="48"/>
    <button group="game" action="roll" label="ROLL" x="730" y="345" r="46"/>
    <button group="game" action="flask" label="FLASK" x="620" y="455" r="44"/>
    <button group="game" action="interact" label="USE" x="620" y="345" r="44"/>
    <button group="game" action="switchWeapon" label="SWAP" x="905" y="62" r="34"/>
    <button group="game" action="debug" label="BOX" x="905" y="132" r="28"/>
    <!-- bonfire menu -->
    <button group="menu" action="menuUp" label="UP" x="110" y="440" r="56"/>
    <button group="menu" action="menuDown" label="DOWN" x="240" y="440" r="56"/>
    <button group="menu" action="interact" label="OK" x="760" y="440" r="56"/>
    <button group="menu" action="back" label="BACK" x="880" y="440" r="56"/>
  </touch>
</ui>
